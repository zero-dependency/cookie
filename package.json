    "cookies",
    "wrapper",
    "parser",
    "serializer",
    "zero-dependency"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zero-dependency",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zero-dependency/zero-dependency.git",
    "directory": "packages/cookie"
  },
  "bugs": {
    "url": "https://github.com/zero-dependency/cookie/issues"
  },
  "author": {
    "name": "Vitalij Ryndin",
    "email": "sys@crashmax.ru",
    "url": "https://crashmax.ru"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
